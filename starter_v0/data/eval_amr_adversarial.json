    {"id":"ADV11_cancel_before_dispatch","phase":"B","suite":"adversarial","turns":[{"role":"user","content":"Gửi AMR-02 đến LAB_B."},{"role":"user","content":"Thôi, tôi hủy yêu cầu trước khi gửi."}],"failure_type":"wrong_boundary","expect":{"no_tool":true},"metadata":{"skill":"withdrawal"}},
